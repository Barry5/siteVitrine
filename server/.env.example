# Variables d'environnement du BACKEND (server/).
# Copiez ce fichier en "server/.env" et renseignez de VRAIES valeurs.
# Ce fichier d'exemple ne doit jamais contenir de vrais identifiants,
# et "server/.env" ne doit jamais être committé (déjà exclu via .gitignore).

# Port d'écoute de l'API Express.
PORT=4000

# Adresse(s) du site autorisée(s) à appeler l'API (CORS), sans slash final.
# Plusieurs adresses possibles, séparées par des virgules.
# En production sur o2switch : "https://colisthiaguil.com,https://www.colisthiaguil.com"
FRONTEND_URL="http://localhost:3000"

# --- Authentification admin -------------------------------------------------
# Mot de passe requis pour se connecter au panneau d'administration.
# AUCUNE valeur par défaut n'est fournie : sans cette variable, la connexion
# admin refuse de fonctionner (503) plutôt que d'accepter un mot de passe
# codé en dur.
ADMIN_PASSWORD=""

# Secret utilisé pour signer les jetons de session admin (chaîne aléatoire
# longue, ex: générée avec `openssl rand -hex 32`). Comme ADMIN_PASSWORD,
# aucune valeur par défaut n'est fournie.
SESSION_SECRET=""

# --- Envoi d'emails (formulaire de contact) --------------------------------
# Paramètres SMTP du compte utilisé pour envoyer les emails de demande de
# contact. Sans ces valeurs, l'API répond 503 plutôt que d'échouer
# silencieusement ou d'inventer un envoi.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Adresse affichée comme expéditeur (souvent identique à SMTP_USER).
SMTP_FROM=""

# Adresse qui reçoit les demandes du formulaire de contact.
CONTACT_RECIPIENT_EMAIL=""

# --- Stockage des départs et affiches -------------------------------------
# Dossier où le serveur enregistre les annonces de départ publiées depuis
# l'admin (announcements.json) et les affiches téléversées (uploads/posters/).
# Par défaut (vide) : server/data/, exclu de git.
# EN PRODUCTION : indiquez un dossier sur un disque PERSISTANT et sauvegardé
# (ex: "/var/lib/thiaguil"), en dehors du dossier de l'application. Sur un
# hébergement à conteneurs, montez un volume persistant sur ce dossier :
# sinon, départs et affiches seront perdus à chaque redéploiement.
# Les affiches sont servies par l'API sous /api/uploads/... : la même règle
# de reverse proxy que /api suffit.
DATA_DIR=""

# --- Déploiement sur o2switch (cPanel « Setup Node.js App ») -----------------
# Sur o2switch, ce fichier n'est pas utilisé : chaque variable ci-dessus se
# renseigne dans le formulaire « Setup Node.js App », rubrique
# « Environment variables ». Réglages de l'application :
#   - Version de Node.js : 22 (le serveur ne fonctionne pas en Node 10) ;
#   - Mode d'application : Production (définit NODE_ENV, ne pas l'ajouter) ;
#   - Racine de l'application : thiaguil-api (hors de public_html) ;
#   - URL de l'application : api.colisthiaguil.com (sous-domaine en HTTPS) ;
#   - Fichier de démarrage : app.cjs
# Ne pas définir PORT : Passenger le gère.
# DATA_DIR : un dossier hors du web, par ex. "/home/<compte>/thiaguil-data".
#
# Fichiers à placer dans le dossier de l'application :
#   package.json, package-lock.json, app.cjs et server/dist/index.mjs
# Le fichier server/dist/index.mjs se génère sur votre PC avec :
#   npm run build:server
# Puis, dans cPanel : « Run NPM Install », puis « Restart ».
# Vérification : https://api.colisthiaguil.com/api/health doit répondre
# {"ok":true,"service":"thiaguil-backend"}.

# "production" active les cookies de session en Secure (HTTPS obligatoire).
NODE_ENV="development"
