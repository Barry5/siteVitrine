# Variables d'environnement du BACKEND (server/).
# Copiez ce fichier en "server/.env" et renseignez de VRAIES valeurs.
# Ce fichier d'exemple ne doit jamais contenir de vrais identifiants,
# et "server/.env" ne doit jamais être committé (déjà exclu via .gitignore).

# Port d'écoute de l'API Express.
PORT=4000

# URL du frontend autorisée en CORS (origine exacte, sans slash final).
FRONTEND_URL="http://localhost:3000"

# --- Authentification admin -------------------------------------------------
# Mot de passe requis pour se connecter au panneau d'administration.
# AUCUNE valeur par défaut n'est fournie : sans cette variable, la connexion
# admin refuse de fonctionner (503) plutôt que d'accepter un mot de passe
# codé en dur.
ADMIN_PASSWORD=""

# Secret utilisé pour signer les jetons de session admin (chaîne aléatoire
# longue, ex: générée avec `openssl rand -hex 32`). Comme ADMIN_PASSWORD,
# aucune valeur par défaut n'est fournie.
SESSION_SECRET=""

# --- Envoi d'emails (formulaire de contact) --------------------------------
# Paramètres SMTP du compte utilisé pour envoyer les emails de demande de
# contact. Sans ces valeurs, l'API répond 503 plutôt que d'échouer
# silencieusement ou d'inventer un envoi.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Adresse affichée comme expéditeur (souvent identique à SMTP_USER).
SMTP_FROM=""

# Adresse qui reçoit les demandes du formulaire de contact.
CONTACT_RECIPIENT_EMAIL=""

# "production" active les cookies de session en Secure (HTTPS obligatoire).
NODE_ENV="development"
